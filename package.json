{
  "name": "atrox-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/start.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/start.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "test:e2e": "node tests/browser.mjs",
    "format": "prettier --write src server shared tests docs *.json *.mjs README.md"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@uiw/react-codemirror": "^4.23.0",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "supertest": "^7.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
