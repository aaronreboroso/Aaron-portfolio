# Node.js 22.13+. Copy to .env for local development. Never commit real secrets.
PORT=5173
ATROX_DATA_DIR=.data

# Required in production: a stable, cryptographically random 32-byte hex key.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Store in a secret manager. Losing this key loses access to encrypted credentials.
ATROX_MASTER_KEY=

# Public HTTPS origin, required for checkout redirects when billing is enabled.
APP_ORIGIN=
# Optional: force secure, partitioned cookies behind an HTTPS preview proxy.
COOKIE_SECURE=false

# Comma-separated exact hostnames of TRUSTED HTTPS webhook destinations.
# Empty disables outbound workflow webhooks. No wildcard hosts or redirects.
ATROX_WEBHOOK_HOSTS=

# Optional Stripe billing. All values and an HTTPS APP_ORIGIN are required.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE=
STRIPE_TEAM_PRICE=

# AI provider keys / model IDs and Netlify site credentials are per-user.
# Configure them in Integrations, not in VITE_* variables or client bundles.
